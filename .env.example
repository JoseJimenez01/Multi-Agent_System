# ===========================
# Qdrant (Vector Database)
# ===========================
QDRANT_VERSION=1.12.0
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_PORT=6334

# ===========================
# Langfuse (LLM Observability)
# SDK — credenciales registradas en la UI (Settings → API Keys)
# Infraestructura Docker — ver docker/.env (secretos de cifrado y DB)
# ===========================
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===========================
# Anthropic Claude (Main LLM)
# ===========================
ANTHROPIC_API_KEY=
# Modelos de Claude:
# - claude-sonnet-4-6: Más potente (para orquestador)
# - claude-haiku-4-5: Económico y rápido (para agentes específicos)
CLAUDE_MODEL_PRIMARY=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5

# ===========================
# OpenAI (Solo para Embeddings)
# ===========================
OPENAI_API_KEY=

# Modelo de embeddings (vectorización de texto)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536